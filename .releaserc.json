{
  "repositoryUrl": "https://github.com/imzusheng/tm_gitlabWeeklyReport.git",
  "branches": ["v2"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "type": "feat", "subject": "/!!/", "release": "major" },
          { "type": "feat", "subject": "/!/", "release": "minor" },
          { "type": "feat", "release": "patch" },
          { "type": "fix", "release": "patch" },
          { "type": "style", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "perf", "release": "patch" },
          { "type": "docs", "release": "patch" },
          { "type": "chore", "release": "patch" },
          { "type": "test", "release": "patch" },
          { "type": "ci", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "breaking": true, "release": "major" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "VITE_APP_VERSION=$SEMANTIC_RELEASE_NEXT_RELEASE_VERSION VITE_GIT_SHA=$(echo $GITHUB_SHA | cut -c1-7) node scripts/semantic-version-update.cjs && VITE_APP_VERSION=$SEMANTIC_RELEASE_NEXT_RELEASE_VERSION VITE_GIT_SHA=$(echo $GITHUB_SHA | cut -c1-7) npm run build",
        "publishCmd": "echo '✅ 版本发布完成，已上传构建产物到 Release'"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/userscript/gitlab-weekly-report.user.js",
            "label": "GitLab Weekly Report Userscript"
          },
          {
            "path": "dist/web/index.html",
            "label": "Web Version"
          }
        ]
      }
    ]
  ]
}
